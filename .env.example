# EmailJS Configuration for Sastha K Portfolio
# Obtain these values from your EmailJS Dashboard (https://dashboard.emailjs.com)

# 1. Your Email Service ID (e.g., service_gmail or service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=

# 2. Template ID for enquiry emails sent to your Gmail (e.g., template_xxxxxxx)
# Template Content:
#   Subject: New Customer Enquiry: {{subject}}
#   Body:
#     New Customer Enquiry
#     Name: {{name}}
#     Email: {{email}}
#     Phone: {{phone}}
#     Subject: {{subject}}
#     Message: {{message}}
#   Reply-To: {{email}}
VITE_EMAILJS_TEMPLATE_ID=

# 3. Your EmailJS Public Key (Account > Public Key)
VITE_EMAILJS_PUBLIC_KEY=

# 4. (Optional) Template ID for the automatic customer THANK YOU email
# If using a separate template for the customer confirmation:
#   To Email: {{email}}
#   Subject: Thank you for contacting Sastha K
#   Body:
#     Hi {{name}},
#
#     Thank you for contacting me through my portfolio website.
#
#     I have received your message successfully and will get back to you soon.
#
#     Regards,
#     Sastha K
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=
